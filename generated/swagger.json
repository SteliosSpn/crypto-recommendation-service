{
  "swagger" : "2.0",
  "info" : {
    "version" : "v0.1",
    "title" : "Cryptocurrency Recommendation Api"
  },
  "host" : "localhost",
  "basePath" : "/",
  "schemes" : [ "http", "https" ],
  "paths" : {
    "/api/v1/crypto/recommendations/metrics/highestNormalizedRange/date/{date}" : {
      "get" : {
        "operationId" : "getHighestNormalizedRangeByDate",
        "produces" : [ "application/json" ],
        "parameters" : [ {
          "name" : "date",
          "in" : "path",
          "required" : true,
          "type" : "string"
        } ],
        "responses" : {
          "200" : {
            "description" : "successful operation",
            "schema" : {
              "$ref" : "#/definitions/CryptoMetricsDto"
            }
          }
        }
      }
    },
    "/api/v1/crypto/recommendations/metrics/normalizedRange/desc" : {
      "get" : {
        "operationId" : "getCryptoMetricsByDescendingNormalizedRange",
        "produces" : [ "application/json" ],
        "responses" : {
          "200" : {
            "description" : "successful operation",
            "schema" : {
              "type" : "array",
              "items" : {
                "$ref" : "#/definitions/CryptoMetricsDto"
              }
            }
          }
        }
      }
    },
    "/api/v1/crypto/recommendations/metrics/{cryptoId}" : {
      "get" : {
        "operationId" : "getCryptoMetrics",
        "produces" : [ "application/json" ],
        "parameters" : [ {
          "name" : "cryptoId",
          "in" : "path",
          "required" : true,
          "type" : "string"
        } ],
        "responses" : {
          "200" : {
            "description" : "successful operation",
            "schema" : {
              "$ref" : "#/definitions/CryptoMetricsDto"
            }
          }
        }
      }
    }
  },
  "definitions" : {
    "CryptoMetricsDto" : {
      "type" : "object",
      "properties" : {
        "cryptocurrency" : {
          "type" : "string"
        },
        "oldestTimestamp" : {
          "type" : "integer",
          "format" : "int64"
        },
        "newestTimestamp" : {
          "type" : "integer",
          "format" : "int64"
        },
        "minPrice" : {
          "type" : "number"
        },
        "maxPrice" : {
          "type" : "number"
        },
        "normalizedRange" : {
          "type" : "number"
        }
      }
    }
  }
}